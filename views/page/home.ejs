<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Expense Management</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-green-100 via-lime-300 to-green-400 min-h-screen font-sans">

    <!-- Header with fade-in animation -->
    <div class="w-full bg-green-400 text-center p-5 border-b-2 border-black flex items-center justify-between animate-fadeIn">
        <h1 class="text-3xl font-bold w-full text-center text-white drop-shadow-lg tracking-wide">Expense Management</h1>
        <button id="logoutBtn"
            class="absolute right-6 top-5 bg-red-500 hover:bg-red-700 transition-colors duration-300 text-white font-bold py-2 px-4 rounded-lg shadow-lg hover:scale-105 active:scale-95">
            Logout
        </button>
    </div>

    <!-- Set Budget Section with animation -->
    <div class="container mx-auto my-5 p-5 bg-white border border-black rounded-3xl w-[95%] max-w-4xl shadow-2xl transition-transform duration-300 hover:scale-105 animate-slideUp">
        <h2 class="text-center text-xl font-bold bg-gradient-to-r from-green-400 via-lime-300 to-green-400 border border-black px-4 py-2 mb-5 rounded shadow animate-fadeInSlow">Set Budget</h2>
        <form id="set-budget-form" class="flex flex-wrap gap-3 justify-center items-center">
            <label for="budget" class="text-lg font-bold mr-2">Set Budget:</label>
            <input type="number" id="budget" placeholder="Enter your budget" required
                class="text-center border-2 border-lime-400 focus:border-green-400 rounded-xl px-3 py-2 font-bold w-44 outline-none focus:ring-2 focus:ring-green-500 transition-all duration-300" />
            <button type="submit" id="set-budget-btn"
                class="bg-lime-400 hover:bg-lime-600 hover:text-white font-bold rounded-xl px-6 py-2 cursor-pointer w-36 shadow-lg transition-all duration-300 hover:scale-105 active:scale-95">
                Set
            </button>
        </form>
        <div class="flex flex-wrap justify-around mt-5 gap-5">
            <div class="w-48 bg-green-50 p-4 border-2 border-lime-400 rounded-2xl text-center shadow transition-transform duration-300 hover:scale-105 animate-fadeIn">
                <h3 class="mb-2 font-semibold text-green-600">Current Budget:</h3>
                <div id="display-budget" class="text-2xl font-bold text-green-800"><%= budget %></div>
            </div>
            <div class="w-48 bg-green-50 p-4 border-2 border-lime-400 rounded-2xl text-center shadow transition-transform duration-300 hover:scale-105 animate-fadeIn">
                <h3 class="mb-2 font-semibold text-green-600">Total Expense:</h3>
                <div id="display-expense" class="text-2xl font-bold text-red-700"><%= totalExpense %></div>
            </div>
            <div class="w-48 bg-green-50 p-4 border-2 border-lime-400 rounded-2xl text-center shadow transition-transform duration-300 hover:scale-105 animate-fadeIn">
                <h3 class="mb-2 font-semibold text-green-600">Remaining:</h3>
                <div id="display-remaining" class="text-2xl font-bold text-lime-700"><%= remaining %></div>
            </div>
        </div>
    </div>

    <!-- Add Expense Section -->
    <div class="container mx-auto my-5 p-5 bg-white border border-black rounded-3xl w-[95%] max-w-4xl shadow-xl transition-transform duration-300 hover:scale-105 animate-slideUp">
        <h2 class="text-center text-xl font-bold bg-gradient-to-r from-green-400 via-lime-300 to-green-400 border border-black px-4 py-2 mb-5 rounded shadow animate-fadeInSlow">Add Expense</h2>
        <form id="add-expense-form" class="flex flex-wrap gap-3 justify-center items-center">
            <label for="expense-name" class="text-lg font-bold mr-2 w-full sm:w-auto">Expense Name:</label>
            <input type="text" id="expense-name" placeholder="Enter expense name" required
                class="text-center border-2 border-lime-400 focus:border-green-500 rounded-xl px-3 py-2 font-bold w-full sm:w-44 outline-none focus:ring-2 focus:ring-green-500 transition-all duration-300" />
            <label for="expense-date" class="text-lg font-bold mr-2 w-full sm:w-auto">Date:</label>
            <input type="date" id="expense-date" required
                class="border-2 border-lime-400 focus:border-green-500 rounded-xl px-3 py-2 font-bold w-full sm:w-44 outline-none focus:ring-2 focus:ring-green-500 transition-all duration-300" />
            <label for="expense-amount" class="text-lg font-bold mr-2 w-full sm:w-auto">Amount:</label>
            <input type="number" id="expense-amount" placeholder="Enter amount" required
                class="text-center border-2 border-lime-400 focus:border-green-500 rounded-xl px-3 py-2 font-bold w-full sm:w-44 outline-none focus:ring-2 focus:ring-green-500 transition-all duration-300" />
            <button type="submit" id="add-expense-btn"
                class="bg-lime-400 hover:bg-lime-600 hover:text-white font-bold rounded-xl px-6 py-2 cursor-pointer w-36 shadow-lg transition-all duration-300 hover:scale-105 active:scale-95">
                Add
            </button>
        </form>
    </div>

    <!-- Expense List Section: Animated table rows on hover -->
    <div class="container mx-auto my-5 p-5 bg-white border border-black rounded-3xl w-[95%] max-w-4xl shadow-xl transition-transform duration-300 hover:scale-105 animate-slideUp">
        <h2 class="text-center text-xl font-bold bg-gradient-to-r from-green-400 via-lime-300 to-green-400 border border-black px-4 py-2 mb-5 rounded shadow animate-fadeInSlow">Expense List</h2>
        <div class="overflow-x-auto">
            <table class="min-w-full border-collapse border border-black text-center">
                <thead>
                    <tr class="bg-green-400 border border-black text-white">
                        <th class="border border-black py-3 px-4">Expense Name</th>
                        <th class="border border-black py-3 px-4">Date</th>
                        <th class="border border-black py-3 px-4">Amount (₹)</th>
                        <th class="border border-black py-3 px-4">Action</th>
                    </tr>
                </thead>
                <tbody id="expense-list">
                    <!-- Dynamic rows get interactive hover here via JS or inline (see below) -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tailwind Custom Animations -->
    <style>
        .animate-fadeIn {
            animation: fadeIn 1s ease-out;
        }
        .animate-fadeInSlow {
            animation: fadeIn 2s ease-out;
        }
        .animate-slideUp {
            animation: slideUp 1s ease;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to   { opacity: 1; }
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px);}
            to   { opacity: 1; transform: translateY(0);}
        }
        /* Interactive hover for expense rows (apply via JS/inline if dynamic) */
        .expense-row:hover {
            background: linear-gradient(90deg, #b9ffb9 10%, #d1ffd4 100%);
            transform: scale(1.03);
            box-shadow: 0 4px 18px rgba(56, 180, 64, .08);
            transition: all .2s;
        }
    </style>
    <script>
        const budgetInput = document.getElementById('budget');
        const budgetDisplay = document.getElementById('display-budget');
        const expenseDisplay = document.getElementById('display-expense');
        const remainingDisplay = document.getElementById('display-remaining');
        const expenseList = document.getElementById('expense-list');

        let budget = 0;
        let totalExpense = 0;
        let remaining = 0;

        // Get current month-year string like '2025-11'
        function getCurrentMonthYear() {
            const now = new Date();
            return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
        }

        // Load budget from localStorage considering month-year
        function loadBudget() {
            const storedMonthYear = localStorage.getItem('budgetMonthYear');
            const currentMonthYear = getCurrentMonthYear();
            if (storedMonthYear === currentMonthYear) {
                const storedBudget = localStorage.getItem('budgetAmount');
                budget = storedBudget ? parseFloat(storedBudget) : 0;
            } else {
                // New month, reset budget to 0 and update storage
                budget = 0;
                localStorage.setItem('budgetAmount', '0');
                localStorage.setItem('budgetMonthYear', currentMonthYear);
            }
            updateDisplays();
        }

        // Save budget to localStorage with current month-year
        function saveBudget(amount) {
            budget = amount;
            const currentMonthYear = getCurrentMonthYear();
            localStorage.setItem('budgetAmount', amount.toString());
            localStorage.setItem('budgetMonthYear', currentMonthYear);
            updateDisplays();
        }

        document.getElementById('set-budget-form').addEventListener('submit', function (e) {
            e.preventDefault();
            if (budgetInput.value === '' || isNaN(budgetInput.value) || parseFloat(budgetInput.value) <= 0) {
                alert("Please enter a valid budget amount");
                return;
            }
            saveBudget(parseFloat(budgetInput.value));
            budgetInput.value = '';
        });

        document.getElementById('logoutBtn').addEventListener('click', async function () {
            try {
                const res = await fetch('/logout', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/';
                }
            } catch (error) {
                alert('Logout failed. Try again.');
            }
        });

        function updateDisplays() {
            remaining = budget - totalExpense;
            budgetDisplay.textContent = `₹${budget}`;
            expenseDisplay.textContent = `₹${totalExpense}`;
            remainingDisplay.textContent = `₹${remaining}`;
        }

        async function fetchExpenses() {
            try {
                const res = await fetch('/expenses');
                const expenses = await res.json();
                let total = 0;
                expenseList.innerHTML = '';
                expenses.forEach(expense => {
                    total += expense.amount;
                    const row = document.createElement('tr');
                    row.innerHTML = `
                    <td>${expense.name}</td>
                    <td>${expense.date ? expense.date.split("T")[0] : ''}</td>
                    <td>₹${expense.amount}</td>
                    <td><button onclick="deleteExpense('${expense._id}')" class="bg-red-400 hover:bg-red-600 text-white font-bold rounded px-3 py-1">Delete</button></td>
                `;
                    expenseList.appendChild(row);
                });
                totalExpense = total;
                updateDisplays();
            } catch (error) {
                alert("Error fetching expenses!");
            }
        }

        document.getElementById('add-expense-form').addEventListener('submit', async function (e) {
            e.preventDefault();
            const name = document.getElementById('expense-name').value.trim();
            const date = document.getElementById('expense-date').value;
            const amount = parseFloat(document.getElementById('expense-amount').value);
            if (!name || !date || isNaN(amount) || amount <= 0) {
                alert("Please enter valid values for all fields. Amount must be > 0.");
                return;
            }
            try {
                await fetch('/expenses', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, amount, date })
                });
                this.reset();
                fetchExpenses();
            } catch (error) {
                alert('Failed to add expense!');
            }
        });

        async function deleteExpense(id) {
            try {
                await fetch(`/expenses/${id}`, { method: 'DELETE' });
                fetchExpenses();
            } catch (error) {
                alert('Failed to delete expense!');
            }
        }

        window.onload = function () {
            loadBudget();
            fetchExpenses();
        };
    </script>

</body>

</html>
